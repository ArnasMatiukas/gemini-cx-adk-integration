# ==============================================================================
# GECX -> ADK Agent Runtime -> Cloud Run API Blueprint (.env template)
# ==============================================================================
# Copy this file to `.env` and fill in your Google Cloud project ID before
# running `python3 deploy_all.py`.

GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_REGION=europe-west1
CES_LOCATION=us

ARTIFACT_REPO_NAME=gecx-skincare-repo
SKINCARE_API_SERVICE_NAME=skincare-vision-api
ADK_AGENT_DISPLAY_NAME=lumiere-skincare-adk-agent-runtime
MODEL_NAME=gemini-3.8-flash

# ==============================================================================
# Gemini Enterprise for Customer Experience (GECX) -> ADK Agent Runtime -> Cloud Run API
# Customer Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your Google Cloud project details before
# running `python3 deploy_all.py`.

# Required: Your Google Cloud Project ID (e.g. my-customer-gcp-project)
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID

# Optional: GCP Region for Cloud Run, Artifact Registry, and Vertex AI Agent Runtime
GCP_REGION=europe-west1

# Optional: GECX (ces.googleapis.com) Location ("us" or "eu")
CES_LOCATION=us

# Optional: Artifact Registry Repository Name
ARTIFACT_REPO_NAME=gecx-skincare-repo

# Optional: Cloud Run Skincare API Service Name & Model
SKINCARE_API_SERVICE_NAME=skincare-nano-banana-api
NANO_BANANA_MODEL=gemini-3.1-flash-image

# Optional: ADK Agent Runtime Settings
ADK_AGENT_DISPLAY_NAME=lumiere-skincare-adk-agent-runtime
ADK_MODEL_NAME=gemini-3.8-flash
ADK_THINKING_BUDGET=8192

# Populated automatically by `deploy_all.py` (or set manually if testing existing resources):
SKINCARE_API_URL=
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GECX_APP_ID=

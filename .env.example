# ==============================================================================
# GECX -> ADK Agent Runtime -> Cloud Run API Blueprint (.env template)
# ==============================================================================
# Copy this file to `.env` and fill in your Google Cloud project ID(s) before
# running `python3 deploy_all.py`.

# Project 1 (Agent Host Project): Hosts Tier 3 Cloud Run Vision API + Tier 2 ADK Agent Runtime
GCP_PROJECT_ID=YOUR_AGENT_HOST_PROJECT_ID

# Project 2 (Optional GECX Front-End Project): Hosts Tier 1 GECX Multi-Flow App (`ces.googleapis.com`).
# Leave empty to deploy all 3 tiers in a single project, or set to a second project ID to enforce
# cross-project least-privilege authentication (custom caller SA + 1-permission custom IAM role on ReasoningEngine).
GECX_PROJECT_ID=

GCP_REGION=europe-west1
CES_LOCATION=us

ARTIFACT_REPO_NAME=gecx-skincare-repo
SKINCARE_API_SERVICE_NAME=skincare-vision-api
ADK_AGENT_DISPLAY_NAME=lumiere-skincare-adk-agent-runtime
MODEL_NAME=gemini-3.8-flash
